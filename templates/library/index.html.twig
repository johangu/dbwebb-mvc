{% extends "base.html.twig" %}

{% block title %}Library book list{% endblock %}

{% block body %}

<h1>Library</h1>
<a href="{{ path('library_new') }}">Add New Book</a><br>
<a href="{{ path('library_reset') }}">Reset library</a>

<div class="book-grid">
	{% for book in books %}
		<div class="book-card">
			<img src="{{ book.image }}" alt="{{ book.title }}" class="book-cover">
			<div class="book-card-body">
				<h2 class="book-title">{{ book.title }}</h2>
				<p class="book-author">{{ book.author }}</p>
				<p class="book-year">{{ book.year }}</p>
				<a href="{{ path('library_one', { id: book.id }) }}" class="view-button">View</a>
				<a href="{{ path('library_edit', { id: book.id }) }}" class="edit-button">Edit</a>
			</div>
		</div>
	{% else %}
		<p>No books found.</p>
	{% endfor %}
</div>

{% endblock %}

