erDiagram
    ROOM ||--o{ PASSAGE : "from_room_id"
    ROOM ||--o{ PASSAGE : "to_room_id"
    ROOM ||--o{ ITEM : "room_id"
    ROOM ||--o{ INTERACTION : "room_id"
    ITEM ||--o{ INTERACTION : "target_id"
    ITEM |o--o{ INTERACTION : "used_item_id"
    ITEM |o--o{ INTERACTION : "reveals_item_id"
    PASSAGE |o--o{ INTERACTION : "unlocks_passage_id"
    INTERACTION |o--o{ INTERACTION : "required_interaction_id"

    ROOM {
        int id PK
        string name
        text description
        string image
    }
    PASSAGE {
        int id PK
        int from_room_id FK
        int to_room_id FK
        string direction
        string verb
        bool locked
    }
    ITEM {
        int id PK
        int room_id FK
        string name
        text description
        bool hidden
        bool pickable
    }
    INTERACTION {
        int id PK
        int room_id FK
        int target_id FK
        int used_item_id FK
        int required_interaction_id FK
        int reveals_item_id FK
        int unlocks_passage_id FK
        bool wins
        text message
    }
    HIGHSCORE {
        int id PK
        string name
        int moves
        datetime created_at
    }
